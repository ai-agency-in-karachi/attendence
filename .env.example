# Copy this file to `.env` and fill in real values.
# Never put real passwords in this file - it IS committed to GitHub.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://attendance_app:YOUR_PASSWORD@localhost:5432/attendance_dev?schema=public"

# Empty helper database Prisma uses to check new migrations
SHADOW_DATABASE_URL="postgresql://attendance_app:YOUR_PASSWORD@localhost:5432/attendance_shadow?schema=public"

# Time zone used to show dates/times in the Super Admin panel (IANA name, e.g. Asia/Karachi)
PLATFORM_TIMEZONE="UTC"
